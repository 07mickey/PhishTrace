# Reference only. Do not deploy with this file unchanged.
# Run `python scripts/setup_env.py` to generate a local .env with a random key.
PHISHTRACE_ENV=development
PHISHTRACE_SECRET_KEY=
PHISHTRACE_HOST=127.0.0.1
PHISHTRACE_PORT=5055
PHISHTRACE_DEBUG=false
PHISHTRACE_MAX_URL_LENGTH=2048
PHISHTRACE_STORE_SCAN_HISTORY=false
PHISHTRACE_DATABASE_PATH=instance/phishtrace.sqlite3
